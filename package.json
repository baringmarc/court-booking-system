{
  "name": "court-booking-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/with-lock.mjs sh scripts/with-docker.sh sh scripts/test-db.sh",
    "smoke:proof": "node scripts/smoke-payment-proof.mjs",
    "smoke:paymongo": "node scripts/smoke-paymongo.mjs",
    "smoke:emails": "node scripts/smoke-emails.mjs",
    "test:e2e": "node scripts/with-lock.mjs playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:db && npm run build && npm run check:drift",
    "preview": "vite preview",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "db:push": "supabase db push",
    "db:start": "sh scripts/with-docker.sh supabase db start",
    "db:stop": "sh scripts/with-docker.sh supabase stop",
    "db:reset:local": "sh scripts/with-docker.sh supabase db reset --local",
    "smoke:prod": "node scripts/smoke-production.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check:drift": "node scripts/check-drift.mjs"
  },
  "dependencies": {
    "@daypicker/react": "10.0.2",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "5.104.3",
    "lucide-react": "^1.61.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "supabase": "2.121.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
