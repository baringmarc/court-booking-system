# Booking and admin pages are never indexed (T30.7). The Worker does not run on them, so the static assets set it.
/booking/*
  X-Robots-Tag: noindex
/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex
# The web manifest (T30.8): the static Plotline one, served when the Worker falls back to the assets.
/manifest.webmanifest
  Content-Type: application/manifest+json
