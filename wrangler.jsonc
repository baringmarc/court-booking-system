{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "court-booking-system",
  "compatibility_date": "2026-10-30",
  // Link previews per venue (T30.7): worker/index.ts rewrites <head> with the venue's card, failing open.
  "main": "worker/index.ts",
  // Static assets with SPA fallback: unknown paths get /index.html with a 200, so deep links work.
  // Asset requests are free and unlimited; only the paths in run_worker_first invoke the Worker, and each invocation
  // counts against the free plan's 100,000 a day (a Worker-first path stops serving past it: RESEARCH "Milestone 30").
  // Keep the list to the pages people share: "/" and "/book". /booking/*, /admin/*, /assets/* never run it.
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/book"]
  },
  // Production's Supabase project (jmichyttnqygwdcksbpg). Both values are public: the publishable key already ships in
  // the frontend bundle, and anon only reads active venues. Never put a secret or service-role key here.
  // Local check against another project: npm run cf:dev -- --var SUPABASE_URL:<url> --var SUPABASE_PUBLISHABLE_KEY:<key>
  "vars": {
    "SUPABASE_URL": "https://jmichyttnqygwdcksbpg.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_DT4E7hUuKDTeMiTLCu2kgg_BQAbJn3q"
  },
  // Serves every venue subdomain (and app.) from one deployment. The apex and www belong to plotline-site.
  "routes": [{ "pattern": "*.plotline.fit/*", "zone_name": "plotline.fit" }]
}
