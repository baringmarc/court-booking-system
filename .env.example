VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional (T9.11g): a Maps Embed API browser key, restricted by HTTP referrer to the site and localhost.
# Without it, the venue map uses the keyless embed URL.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Walk-in bookings on the admin dashboard (T11.2). Hidden unless this is exactly `true`; leave unset on Vercel.
VITE_FEATURE_WALK_INS=false
