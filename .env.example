VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Walk-in bookings on the admin dashboard (T11.2). Hidden unless this is exactly `true`; leave unset on Vercel.
VITE_FEATURE_WALK_INS=false
# The venue for a host with no subdomain (npm run dev on localhost, previews, the Vercel URL). Set it on Vercel too (unlike the flag above): without it the site shows "Venue not found". T13.8 retires it with Vercel.
VITE_DEFAULT_VENUE=claudex-courts
