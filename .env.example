VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The venue for a host with no subdomain (npm run dev on localhost, previews, the Vercel URL). Set it on Vercel too: without it the site shows "Venue not found". T13.8 retires it with Vercel.
VITE_DEFAULT_VENUE=claudex-courts
# Error reporting for the app and console (T16.3). Leave empty locally; set it on the Cloudflare build for staging/production.
VITE_SENTRY_DSN=
