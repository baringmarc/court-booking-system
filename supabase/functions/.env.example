# Edge Function secrets. Locally: copy to supabase/functions/.env (gitignored). Linked project: set each with
# `npx supabase secrets set NAME=value`. Never put these in VITE_* vars or anywhere under src/.

# PayMongo TEST secret key (must start with sk_test_; live keys are refused). When set, it is used even if
# PAYMONGO_MODE=stub. Leave empty to use stub mode locally.
PAYMONGO_SECRET_KEY=
# Signing secret of the PayMongo webhook endpoint (paymongo-webhook). The value below is for the local stack only
# (smoke and e2e sign fake events with it); the function refuses it on the hosted project. Use the endpoint's real
# secret there.
PAYMONGO_WEBHOOK_SECRET=whsk_local_dev_only
# Comma-separated site origins allowed in PayMongo success/cancel links; the first is the default.
PUBLIC_SITE_URL=http://localhost:5173,http://127.0.0.1:5179
# Local development only: `stub` returns a fake checkout session when no test key is set. It is ignored on the
# hosted project (only honoured when SUPABASE_URL is the local http stack).
PAYMONGO_MODE=stub

# Booking emails (SPEC §8). resend | mailpit | disabled. Unset: mailpit on the local stack, disabled on the hosted
# project (the hosted default for now: queued emails are marked skipped). mailpit is honoured only locally.
EMAIL_TRANSPORT=mailpit
# Local Mailpit as the edge runtime sees it on the Docker network (local only).
MAILPIT_URL=http://supabase_inbucket_court-booking-system:8025
# Sender. With Resend it must be an address on your verified domain.
EMAIL_FROM=Claudex Courts <no-reply@claudex.test>
# Shared with pg_cron (Vault secret email_worker_secret) so only it can call send-emails. The value below is for the
# local stack only; the function refuses it on the hosted project.
EMAIL_WORKER_SECRET=email_worker_local_dev_only
# Resend API key (only with EMAIL_TRANSPORT=resend). Leave empty for now.
RESEND_API_KEY=
